{
  // 모든 태스크는 셸을 거치지 않는 "process" 방식이다. shell 방식은 VSCode가 pwsh -Command 로 실행하면서
  // 경로의 따옴표("C:\Program Files (x86)\...")를 벗겨 버려 오류가 났다(x86: 용어를 인식할 수 없음).
  "version": "2.0.0",
  "inputs": [
    {
      // 보드 조작은 실행할 때마다 확인한다. 기본값은 '아니오'라서 엔터만 눌러도 보드는 건드리지 않는다.
      "id": "boardConfirm",
      "type": "pickString",
      "description": "보드에 다운로드합니다. 히터/모터/SSR 부하가 연결되어 있으면 동작할 수 있습니다. 진행할까요?",
      "options": [
        { "label": "아니오 (빌드와 Make까지만 하고 보드는 건드리지 않음)", "value": "no" },
        { "label": "예, 보드에 다운로드합니다", "value": "yes" }
      ],
      "default": "no"
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "HOTDOG: compile_commands 생성",
      "detail": "clangd/clang-tidy/cppcheck용 build/compile_commands.json 생성 (처음 한 번, 소스 목록이 바뀔 때)",
      "type": "process",
      "command": "python",
      "args": ["tools/gen_compile_commands.py", "--dfb-root", "${config:hotdog.dfbRoot}"],
      "problemMatcher": []
    },
    {
      // 컴파일러는 build/ 에서 실행되므로 파일 경로가 ..\src\... 형태다. 형식 예:
      //   ..\src\ap\ap.c:138:(I)7112 block scope identifier "arg" is declared but not used.
      //   ..\src\bsp\startup\startup.as:267:as103S:(W2702):The usage of this instruction may be restricted ...
      // 링커(ld103s) 오류 형식은 아직 확인하지 못해서 포함하지 않았다.
      "label": "HOTDOG: Build",
      "detail": "증분 빌드 → build/BAKERY_DF05.x, OUTPUT/Hotdog.hex",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py", "--dfb-root", "${config:hotdog.dfbRoot}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [
        {
          "owner": "cc103s",
          "source": "cc103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):\\((E|W|I)\\)(\\d+)\\s+(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        },
        {
          "owner": "as103s",
          "source": "as103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):as103S:\\((E|W)(\\d+)\\):(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        }
      ]
    },
    {
      "label": "HOTDOG: Rebuild",
      "detail": "build/ 를 비우고 전체 다시 빌드",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py", "rebuild", "--dfb-root", "${config:hotdog.dfbRoot}"],
      "group": "build",
      "problemMatcher": [
        {
          "owner": "cc103s",
          "source": "cc103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):\\((E|W|I)\\)(\\d+)\\s+(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        },
        {
          "owner": "as103s",
          "source": "as103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):as103S:\\((E|W)(\\d+)\\):(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        }
      ]
    },
    {
      "label": "HOTDOG: Clean",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py", "clean", "--dfb-root", "${config:hotdog.dfbRoot}"],
      "problemMatcher": []
    },
    {
      "label": "HOTDOG: Build 명령만 보기 (dry-run)",
      "detail": "컴파일러를 실행하지 않고 DFB5와 같은 명령줄만 출력",
      "type": "process",
      "command": "python",
      "args": ["tools/build.py", "--dry-run", "--dfb-root", "${config:hotdog.dfbRoot}"],
      "problemMatcher": []
    },
    {
      "label": "HOTDOG: ROM/RAM 사용량",
      "detail": "build/BAKERY_DF05.map 요약 (--save 로 이력을 남기면 다음부터 변화량 표시)",
      "type": "process",
      "command": "python",
      "args": ["tools/memreport.py"],
      "problemMatcher": []
    },
    {
      "label": "HOTDOG: 호스트 유닛테스트",
      "detail": "src/ 의 순수 로직(qbuffer, Pid, Modbus CRC)을 PC에서 실행",
      "type": "process",
      "command": "python",
      "args": ["tests/run_tests.py"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "HOTDOG: 빌드 + 보드 다운로드 + 실행 (DFB5)",
      "detail": "VSCode 빌드 → DFB5 Make → DFB5가 보드에 다운로드 → 실행. 보드를 조작하므로 확인창이 뜬다. DFB5가 열려 있으면 보드 단계는 건너뛴다.",
      "type": "process",
      "command": "python",
      "args": ["tools/dfb5.py", "run", "--dfb-root", "${config:hotdog.dfbRoot}", "--confirm", "${input:boardConfirm}"],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": [
        {
          "owner": "cc103s",
          "source": "cc103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):\\((E|W|I)\\)(\\d+)\\s+(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        },
        {
          "owner": "as103s",
          "source": "as103s",
          "fileLocation": ["relative", "${workspaceFolder}/build"],
          "pattern": { "regexp": "^(.+?):(\\d+):as103S:\\((E|W)(\\d+)\\):(.*)$", "file": 1, "line": 2, "severity": 3, "code": 4, "message": 5 }
        }
      ]
    },
    {
      "label": "HOTDOG: 빌드 + 보드 다운로드 (실행은 안 함)",
      "detail": "위와 같지만 다운로드만 하고 프로그램은 실행하지 않는다(DFB5에서 브레이크 등을 먼저 걸고 싶을 때).",
      "type": "process",
      "command": "python",
      "args": ["tools/dfb5.py", "run", "--no-go", "--dfb-root", "${config:hotdog.dfbRoot}", "--confirm", "${input:boardConfirm}"],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "HOTDOG: DFB5 설정과 소스 목록 비교",
      "detail": "DF/BAKERY_DF05.mak 와 tools/project.json 이 어긋났는지 확인",
      "type": "process",
      "command": "python",
      "args": ["tools/check_sync.py"],
      "problemMatcher": []
    }
  ]
}
